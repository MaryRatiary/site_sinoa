# ============================================
# SHOPIFY CONFIGURATION - À CONFIGURER DEPUIS NETLIFY
# ============================================

# 1. Magasin Shopify
# Format: "votre-boutique.myshopify.com"
VITE_SHOPIFY_STORE=votre-boutique.myshopify.com
# NB : doit correspondre au domaine qui sert /products/{handle}
# (utilisé pour l'URL de l'iframe produit ET la validation d'origine postMessage).

# 2. Token d'accès Storefront (Accès en lecture seule aux produits et checkout)
# Obtenir depuis: Shopify Admin > Apps and integrations > Develop apps > Storefront API > Access tokens
VITE_SHOPIFY_STOREFRONT_TOKEN=votre_storefront_access_token_ici

# 3. Version de l'API Shopify
# Format recommandé: 2024-01 (année-mois)
VITE_SHOPIFY_API_VERSION=2024-01

# 4. URL de votre site (pour les webhooks de retour)
VITE_SITE_URL=https://votre-site.com

# ============================================
# CONFIGURATION OPTIONNELLE
# ============================================

# Admin API Token (optionnel - pour les commandes côté serveur)
SHOPIFY_ADMIN_TOKEN=votre_admin_token_ici

# Currency (défaut: EUR pour France)
VITE_CURRENCY=EUR

# Webhook Secret (pour valider les requêtes Shopify)
SHOPIFY_WEBHOOK_SECRET=votre_webhook_secret_ici
